# Copy to .env and fill in your own values. Never commit .env.

# --- Auth (JWT) ---
# Long random strings, different from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# --- Database (Prisma + Supabase Postgres) ---
DATABASE_URL=      # pooled connection, used at runtime
DIRECT_URL=        # direct connection, used for Prisma migrations

# --- Supabase Storage ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Server-side only: bypasses row-level security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_QUEST_PHOTO_BUCKET=quest-evidence   # optional, this is the default
SUPABASE_JOURNAL_BUCKET=journal-photos       # optional, this is the default

# --- One-off seed script only (generates AR guide dialogue) ---
GEMINI_API_KEY=

# --- Server (optional) ---
# PORT=3000
